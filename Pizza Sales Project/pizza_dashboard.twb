                    <run bold='true' fontalignment='1' fontcolor='#75a1c7'>WEEKS</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#ff00ff'>Significant variations in weekly orders</run>
